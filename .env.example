NODE_ENV=development
PORT=4501
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:4500,http://localhost:4502,http://localhost:4503
LOG_LEVEL=info
# Required in production: requests to protected routes need X-API-Key matching this.
# API_KEY=dev-secret-key
# Local Supabase (supabase start): API http://127.0.0.1:54321
# SUPABASE_URL=http://127.0.0.1:54321
# Service-role key from `supabase status`. Never expose to clients.
# SUPABASE_SERVICE_ROLE_KEY=
